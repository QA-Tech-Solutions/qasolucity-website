RESEND_API_KEY=

# Set to "true" to show the maintenance page for every visitor
MAINTENANCE_MODE=false

# Optional: lets the team preview the live site during maintenance via
# /?bypass=<value>, which sets a cookie granting access
MAINTENANCE_BYPASS_SECRET=

# Token the qasolucity-automation CI job authenticates with when POSTing
# live test-run metrics to /api/quality-metrics. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUTOMATION_API_TOKEN=
# Sample - https://www.qasolucity.vercel.app, https://www.qasolucity.com
SITE_URL=

# Where /api/quality-metrics actually stores the latest automation run.
# Not needed for local dev — without these, it falls back to a local
# JSON file automatically. In production (Vercel), connect the Upstash
# Redis integration from the Marketplace tab and these get set for you;
# no need to fill them in by hand.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live USD->NGN rate providers for the ISTQB Certification Bundle price
# calculator (see lib/certification-pricing.ts). Both are optional — if
# neither is set, pricing falls back to the last cached rate (stored via
# the Upstash keys above, or a local JSON file in dev) and finally to a
# hardcoded emergency baseline, so the page always works without these.
# Tier 1 (primary) — https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=
# Tier 2 (secondary fallback) — https://currencyfreaks.com/
CURRENCYFREAKS_API_KEY=
